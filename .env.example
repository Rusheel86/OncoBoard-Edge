# REQUIRED FOR HACKATHON: Gemma 4 is the primary reasoning engine for this submission.
# To use Gemma 4, provide your Google API key below and set ONCO_LLM_PROVIDER=google.
GOOGLE_API_KEY=
HF_TOKEN=
WANDB_API_KEY=
# Provider selection: google (Gemma 4 via Google AI Studio, PRIMARY), ollama (local LLM), offline (deterministic fallback)
ONCO_LLM_PROVIDER=google
ONCO_GEMMA_MODEL=gemma-4-26b-a4b-it
ONCO_LOCAL_LLM_URL=http://localhost:11434
ONCO_LOCAL_LLM_MODEL=gemma4:e4b
ONCO_CHROMA_DIR=.oncoedge/chroma
ONCO_MAX_UPLOAD_MB=25
ONCO_USE_WHISPER=0
ONCO_WHISPER_MODEL=base
ONCO_DEBUG_ERRORS=0
